@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam nodesep 35
skinparam ranksep 90
skinparam ArrowFontSize 11

actor Usuario as U
actor "Tiempo (Sistema)" as T
actor "Servicio de notificaciones push" as PUSH <<sistema externo>>
actor "Servicio de email" as MAIL <<sistema externo>>

rectangle "Sistema de Retiros Holísticos" {
  usecase "1. Registrar nuevo retiro"    as UC1
  usecase "2. Consultar retiro agendado" as UC2
  usecase "3. Modificar retiro agendado" as UC3
  usecase "4. Dar de baja un retiro"     as UC4
  usecase "8. Registrar valoración"      as UC8

  usecase "5. Registrar actividad" as UC5
  usecase "6. Registrar categoría" as UC6
  usecase "7. Registrar pago"      as UC7

  usecase "9. Registrar y enviar notificaciones" as UC9
  usecase "10. Actualizar estado Retiro"         as UC10
}

U --> UC1
U --> UC2
U --> UC3
U --> UC4
U --> UC8
U --> UC5
U --> UC6
U --> UC7

UC5 .down.> UC1 : <<extend>>
UC5 .down.> UC3 : <<extend>>
UC6 .down.> UC1 : <<extend>>
UC6 .down.> UC3 : <<extend>>
UC7 .down.> UC1 : <<extend>>
UC7 .down.> UC3 : <<extend>>

T --> UC9
T --> UC10

UC9 --> PUSH
UC9 --> MAIL
@enduml